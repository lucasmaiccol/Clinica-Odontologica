# =============================================================
# VARIABLES DE ENTORNO — CLÍNICA DENTAL
# Copia este archivo como ".env.local" (desarrollo) y completa
# los valores reales. NUNCA subas ".env.local" a GitHub.
# =============================================================

# --- SUPABASE (proyecto -> Settings -> API) ---------------------
# Pública: se expone en el navegador (prefijo NEXT_PUBLIC_). No es secreta.
NEXT_PUBLIC_SUPABASE_URL=
# Pública también (clave "anon"). Protegida por Row Level Security, no por secreto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privada. NUNCA debe tener el prefijo NEXT_PUBLIC_ ni usarse en el cliente.
# Solo se usa en Server Actions / Route Handlers (server-side).
SUPABASE_SERVICE_ROLE_KEY=

# --- BASE DE DATOS (proyecto -> Settings -> Database) -----------
# Connection pooling (puerto 6543, pgbouncer). Úsala en runtime/serverless
# (Route Handlers, Server Components, Vercel).
DATABASE_URL=

# Conexión directa (puerto 5432, sin pooler). Úsala SOLO para migraciones
# de Prisma en local (prisma migrate dev / deploy).
DIRECT_URL=

# --- APP ----------------------------------------------------------
# URL pública del sitio (usada en metadata, sitemap y JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
